{
  "name": "poke-wildfront",
  "version": "0.86.4",
  "description": "Unofficial, free, open-source Pokémon tactical RPG fan game for the browser.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:single": "npm run build && node tools/build-single.mjs",
    "test:e2e": "node e2e/smoke.mjs",
    "balance": "BALANCE=1 vitest run tests/balance.report.test.ts --silent=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TorlofGusev/poke_wildfront.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TorlofGusev/poke_wildfront/issues"
  },
  "homepage": "https://github.com/TorlofGusev/poke_wildfront#readme",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "playwright": "1.63.0"
  },
  "private": true,
  "type": "module"
}
